{
  "name": "vr-creative-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Physics-real VR creative sandbox (WebXR, Quest 3S target, desktop fallback)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "tsc --noEmit -p . && vitest run",
    "workbench": "node tools/workbench/build.mjs"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "fflate": "^0.8.3",
    "jolt-physics": "^1.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "fast-check": "^4.10.2",
    "iwer": "^2.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
