{
  "name": "vr-creative-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Physics-real VR creative sandbox (WebXR, Quest 3S target, desktop fallback)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "app": "vite build --config vite.view.config.ts --logLevel error && NODE_USE_ENV_PROXY=1 vite preview --config vite.view.config.ts --port 5173",
    "gate": "tsc --noEmit -p . && vitest run",
    "gate:field": "tsc --noEmit -p . && vitest run tests/nexus/domains.test.ts -t",
    "docs": "UPDATE_DOCS=quick vitest run tests/nexus/domains.test.ts",
    "probe": "NODE_USE_ENV_PROXY=1 timeout 120 vitest run --silent=false",
    "check": "NODE_USE_ENV_PROXY=1 timeout 120 vitest run tests/nexus/check.test.ts --silent=false",
    "nexus:build": "vite build --config vite.nexus.config.ts",
    "breakdown": "vite build --config vite.nexus.config.ts --logLevel error && node dist-nexus/breakdown.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@sinclair/typebox": "^0.34.52",
    "fflate": "^0.8.3",
    "jolt-physics": "^1.1.0",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "1.1.0",
    "three": "^0.186.1",
    "three-bvh-csg": "0.0.18",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "fast-check": "^4.10.2",
    "iwer": "^2.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
